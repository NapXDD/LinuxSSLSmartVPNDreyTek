# DrayTek e2e test configuration — template.
#
# Copy this file to e2e.env (same directory), fill in your values, and run
# tests/e2e/e2e-fedora.sh (or podman-smoke.sh). e2e.env is gitignored so
# credentials never end up in a commit; still, keep it private:
#   chmod 600 tests/e2e/e2e.env
#
# Values here are shell assignments (the file is sourced). Quote values
# containing spaces or special characters. Variables already set in the
# environment take precedence over this file.

# ── Required for the connect + ping phases ────────────────────────
DRAYTEK_GATEWAY=""          # VPN server hostname or IP, e.g. "vpn.example.com"
DRAYTEK_USERNAME=""         # VPN username
DRAYTEK_PASSWORD=""         # VPN password

# ── Optional (defaults shown) ─────────────────────────────────────
#DRAYTEK_PORT="443"         # SSL VPN port
#DRAYTEK_VERIFY_CERT="no"   # TLS certificate verification (yes/no)
#DRAYTEK_DEFAULT_ROUTE="no" # "yes" = route ALL traffic through the VPN
                            # (Smart VPN's "use default gateway on remote
                            # network"; sets never-default=no). The e2e
                            # then also asserts the default route goes via
                            # the tunnel and plain pings use it.
#PING_TARGET="8.8.8.8"      # Host to ping through the tunnel. Internet ping
                            # requires the router to forward tunnel traffic
                            # upstream — use a LAN host behind the router
                            # (e.g. "192.168.1.1") otherwise.
#PING_COUNT="4"             # Number of pings
#CONNECT_TIMEOUT="60"       # Seconds to wait for nmcli connection up
